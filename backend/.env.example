# Server runtime: development | test | production.
NODE_ENV=development

# HTTP port for the backend API.
PORT=3001

# Pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Application version reported by health checks. Defaults to package version.
NPM_PACKAGE_VERSION=0.1.0

# Seconds to wait during graceful shutdown before forcing process exit.
GRACEFUL_SHUTDOWN_TIMEOUT=30

# SQLite/PostgreSQL connection string used by backend persistence.
DATABASE_URL=./data/ai-net.db

# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# Optional comma-separated bearer API keys for protected API access.
API_KEYS=

# Optional shared secret for admin endpoints such as /health/dashboard.
ADMIN_API_KEY=

# Stellar network selector: testnet | mainnet | local | futurenet.
STELLAR_NETWORK=testnet

# Stellar Horizon endpoint used for account and payment checks.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional legacy alias for STELLAR_HORIZON_URL.
STELLAR_HORIZON=

# Optional backend coordinator secret key for payment release signing.
STELLAR_COORDINATOR_SECRET=

# Optional testnet secret key used by live Stellar E2E tests.
STELLAR_TEST_SECRET=

# Optional public key used when local agents self-register.
STELLAR_PUBLIC_KEY=

# Soroban RPC URL used by registry event sync.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional deployed AgentRegistry contract ID for event sync.
REGISTRY_CONTRACT_ID=

# Set true only in local/test runs to bypass Horizon account validation.
SKIP_STELLAR_ACCOUNT_VERIFY=false

# Venice AI API key. Required outside NODE_ENV=test.
VENICE_API_KEY=your_venice_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Filesystem path to the SQLite database holding the ai-net schema.
# Applied by `npm run db:migrate` (see src/db/migrations/).
DATABASE_URL=./data/ai-net.db

# Optional: keep the versioned migration files outside src/db/migrations.
# DB_MIGRATIONS_DIR=./db/migrations
# Venice API base URL.
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Logical model version used in Venice response cache keys.
VENICE_MODEL_VERSION=v1

# Default Venice response cache TTL in milliseconds.
VENICE_CACHE_TTL_MS=86400000

# Shorter Venice cache TTL for coding-agent responses in milliseconds.
VENICE_CACHE_CODING_TTL_MS=3600000

# Similarity threshold for semantic Venice cache reuse.
VENICE_CACHE_SIMILARITY_THRESHOLD=0.8

# Cache backend: lru | redis.
CACHE_DRIVER=lru

# Redis connection URL used when CACHE_DRIVER=redis.
REDIS_URL=redis://localhost:6379

# Maximum entries held by the in-process LRU cache.
CACHE_LRU_MAX_SIZE=500

# Agent list cache TTL in seconds.
CACHE_TTL_AGENTS=60

# Stats cache TTL in seconds.
CACHE_TTL_STATS=30

# Health cache TTL in seconds.
CACHE_TTL_HEALTH=10

# Deployment-scoped prefix for registry cache keys (Issue #427).
# Change this per environment (e.g. "staging", "prod") when multiple
# deployments share the same Redis instance.
REGISTRY_CACHE_KEY_PREFIX=registry

# Maximum accepted task prompt length in characters.
MAX_PROMPT_LENGTH=10000

# Maximum tasks per wallet per rolling 24h window. Set 0 to disable.
DAILY_TASK_LIMIT_PER_WALLET=100

# Per-IP rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# Maximum task-create requests per IP per window.
RATE_LIMIT_MAX_REQUESTS=20

# Per-route-group limits (token-bucket, per IP, rolling window)
# Public routes: /health, /api/stats, GET /api/agents
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX_REQUESTS=120
# Authenticated routes: /api/tasks
RATE_LIMIT_AUTHED_WINDOW_MS=60000
RATE_LIMIT_AUTHED_MAX_REQUESTS=30
# Admin routes: /api/admin/*
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX_REQUESTS=20

# ── Per-Wallet Daily Quota ────────────────────────────────────────────────────
# Maximum tasks a single wallet address may create within a rolling 24-hour
# window. Set to 0 to disable the quota entirely.
DAILY_TASK_LIMIT_PER_WALLET=100

# Agent cleanup loop interval in milliseconds.
HEARTBEAT_INTERVAL_MS=300000

# Minutes before an unseen agent is considered stale.
HEARTBEAT_STALE_THRESHOLD_MINUTES=5

# Hours before stale offline agents are deleted.
AGENT_OFFLINE_DELETE_HOURS=24

# Optional webhook for reconciliation discrepancy alerts.
RECONCILIATION_WEBHOOK_URL=

# Automated reconciliation interval in milliseconds.
RECONCILIATION_INTERVAL_MS=86400000

# Minimum response size in bytes before compression is attempted.
COMPRESSION_THRESHOLD=1024

# gzip/Brotli compression level. gzip uses 1-9.
COMPRESSION_LEVEL=6

# Enable Brotli when clients advertise br support.
COMPRESSION_ENABLE_BROTLI=true

# Latest API version advertised by versioning middleware.
API_LATEST_VERSION=2.0

# Comma-separated API versions accepted by the server.
API_SUPPORTED_VERSIONS=1.0,1.1,2.0

# API version used when the client omits API-Version.
API_DEFAULT_VERSION=1.0

# Optional HTTP Sunset header value for v1 clients.
API_V1_SUNSET_DATE=

# Maximum concurrent WebSocket stream connections per client IP.
WS_MAX_CONNECTIONS_PER_CLIENT=5

# Maximum WebSocket messages per minute per connection.
WS_MAX_MESSAGES_PER_MINUTE=100

# WebSocket inactivity timeout in milliseconds.
WS_INACTIVITY_TIMEOUT_MS=1800000

# WebSocket heartbeat ping interval in milliseconds.
WS_HEARTBEAT_INTERVAL_MS=30000

# WebSocket pong timeout in milliseconds.
WS_PONG_TIMEOUT_MS=10000

# Health dashboard cache TTL in milliseconds.
METRICS_CACHE_TTL_MS=5000

# Rolling metrics analytics window in milliseconds.
METRICS_WINDOW_MS=60000

# Maximum HTTP request samples retained in memory.
METRICS_MAX_SAMPLES=1000

# ── Event store retention & compaction ───────────────────────────────────────

# On-disk path for the append-only event store. Must be a file path for the
# retention job to be meaningful; the event log is discarded on restart when
# this is :memory:.
EVENT_STORE_PATH=./data/events.db

# Retention window in days. Events for finished tasks older than this are
# archived (full-fidelity) and purged from the live task_events table.
EVENT_RETENTION_DAYS=30

# How often the compaction pass runs in milliseconds.
EVENT_COMPACTION_INTERVAL_MS=3600000

# Maximum tasks compacted per pass, bounding writer-lock hold time.
EVENT_COMPACTION_BATCH_TASKS=50

# Master switch for the retention job.
EVENT_COMPACTION_ENABLED=true

# ── Authentication & Session Security ───────────────────────────────────────
# JWT secret key used to sign and verify access tokens. Required in production.
# Must be at least 32 characters. Do not use placeholder values.
AUTH_JWT_SECRET=your_secure_jwt_secret_minimum_32_characters

# Access token validity in seconds. Default: 900 (15 min).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token sliding expiry validity in seconds. Default: 604800 (7 days).
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Max absolute session lifetime in seconds. Default: 2592000 (30 days).
AUTH_SESSION_MAX_TTL_SECONDS=2592000

# ── Database Pool Configuration ─────────────────────────────────────────────
# Minimum number of connections in the pool. Default: 2.
DB_POOL_MIN=2

# Maximum number of connections in the pool. Default: 10.
DB_POOL_MAX=10

# Timeout in milliseconds to acquire a connection from the pool. Default: 5000.
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# Enable health check on pool connections. Default: true.
DB_POOL_HEALTH_CHECK=true

# Directory for database backups. Default: ./data/backups.
DB_BACKUP_DIR=./data/backups

# Number of backup files to retain. Default: 5.
DB_BACKUP_RETENTION_COUNT=5

# Interval in milliseconds for database maintenance jobs. Default: 3600000 (1 hour).
DB_MAINTENANCE_INTERVAL_MS=3600000

# Threshold of records before running VACUUM. Default: 100.
DB_MAINTENANCE_VACUUM_THRESHOLD=100

# ── Error Registry Configuration ─────────────────────────────────────────────
# Interval in milliseconds for error registry maintenance. Default: 3600000 (1 hour).
ERROR_REGISTRY_MAINTENANCE_INTERVAL_MS=3600000

# Maximum error entries per agent. Default: 100.
ERROR_REGISTRY_CAP_PER_AGENT=100

# ── Rate Limit Configuration ─────────────────────────────────────────────────
# Maximum registration requests per IP per window. Default: 10.
REGISTER_RATE_LIMIT_MAX_REQUESTS=10

# Per-route-group limits (token-bucket, per IP, rolling window)
# Public routes: /health, /api/stats, GET /api/agents
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX_REQUESTS=120
# Authenticated routes: /api/tasks
RATE_LIMIT_AUTHED_WINDOW_MS=60000
RATE_LIMIT_AUTHED_MAX_REQUESTS=30
# Admin routes: /api/admin/*
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX_REQUESTS=20

# ── Quality Scorer Configuration ─────────────────────────────────────────────
# Weight for completeness score in quality calculation. Default: 0.4
QUALITY_WEIGHT_COMPLETENESS=0.4

# Weight for relevance score in quality calculation. Default: 0.3
QUALITY_WEIGHT_RELEVANCE=0.3

# Weight for format score in quality calculation. Default: 0.3
QUALITY_WEIGHT_FORMAT=0.3

# Threshold for requiring manual review. Default: 60
QUALITY_REVIEW_THRESHOLD=60

# Enable percentile-based quality scoring. Default: false
QUALITY_PERCENTILE_ENABLED=false

# Minimum samples required for percentile calculation. Default: 10
QUALITY_PERCENTILE_MIN_SAMPLES=10

# ── Admin Control Configuration ─────────────────────────────────────────────
# Enable read-only mode for the API. Default: false
AI_NET_READ_ONLY=false

# Reason for read-only mode. Optional.
AI_NET_READ_ONLY_REASON=

# Path to admin audit database. Default: ./data/admin-audit.db
ADMIN_AUDIT_DB_PATH=./data/admin-audit.db

# Directory for admin backups. Default: ./data/backups/admin
ADMIN_BACKUP_DIR=./data/backups/admin

# ── Agent Watchdog Configuration ──────────────────────────────────────────────
# Agent heartbeat watchdog: grace period before eviction (Issue #379).
AGENT_WATCHDOG_INTERVAL_MS=60000
AGENT_WATCHDOG_GRACE_MINUTES=10

# ── Idempotency Store Configuration (Issue #657) ────────────────────────────
# How long idempotency keys are retained before they can be replayed. Default: 24 h.
IDEMPOTENCY_TTL_MS=86400000

# How often the background cleanup sweep runs to delete expired keys. Default: 5 min.
IDEMPOTENCY_CLEANUP_MS=300000

# ── Venice Cache Configuration ───────────────────────────────────────────────
# Logical model version used in Venice response cache keys.
VENICE_MODEL_VERSION=v1

# Default Venice response cache TTL in milliseconds.
VENICE_CACHE_TTL_MS=86400000

# Shorter Venice cache TTL for coding-agent responses in milliseconds.
VENICE_CACHE_CODING_TTL_MS=3600000

# Similarity threshold for semantic Venice cache reuse.
VENICE_CACHE_SIMILARITY_THRESHOLD=0.8

# ── Health Probe Configuration ───────────────────────────────────────────────
# Timeout in milliseconds for health probes. Default: 5000.
HEALTH_PROBE_TIMEOUT_MS=5000
